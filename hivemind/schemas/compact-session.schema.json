{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contract_version", "ok", "packet_version", "view", "session_id", "cluster", "status", "context", "refs", "offered", "omitted", "budget", "notice", "next_commands"],
  "properties": {
    "contract_version": {"const": 1}, "ok": {"const": true},
    "packet_version": {"const": 1}, "view": {"const": "compact"},
    "session_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "cluster": {"type": "string"}, "status": {"const": "context_offered"},
    "previous_context_at": {"type": ["string", "null"]},
    "previous_session_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "runtime": {"type": "object", "required": ["id", "source", "last_source"]},
    "context": {"type": "object", "required": ["text", "budget", "word_count", "task_match"],
                "properties": {"text": {"type": "string"}, "budget": {"type": "integer"}, "word_count": {"type": "integer"}, "task_match": {"type": ["boolean", "null"]}}},
    "refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ref", "title", "evidence", "freshness"],
      "properties": {"ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*@[a-f0-9]{64}$"}, "title": {"type": "string"}, "evidence": {"enum": ["confirmed", "reported", "inferred", "disputed"]}, "freshness": {"enum": ["stale", "within_review_window"]}}}},
    "offered": {"type": "array"}, "omitted": {"type": "object"}, "next_commands": {"type": "array", "items": {"type": "string"}},
    "notice": {"type": "string"}, "budget": {"type": "object", "required": ["max_bytes", "bytes", "unit"],
      "properties": {"max_bytes": {"type": "integer", "minimum": 4096, "maximum": 65536}, "bytes": {"type": "integer", "maximum": 65536}, "unit": {"type": "string"}}}
  },
  "additionalProperties": false
}
