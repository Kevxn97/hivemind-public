{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "ok": {
      "const": true
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "draft": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "contract_version",
    "ok",
    "session_id",
    "draft"
  ],
  "additionalProperties": false
}
